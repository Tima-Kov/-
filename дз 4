# Упражнение 5-6

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

df = pd.read_csv('C:/Users/user/Desktop/BTC_data.csv')

dates = list(df.iloc[:, 0])
close = list(df.iloc[:, -1])

x = np.arange(len(close))
y = np.array(close)
z = np.polyfit(x, y, 15)
p = np.poly1d(z)

pos = []
goda = []
for i in range(len(dates)):
    god = dates[i][0:4]
    if god not in goda:
        goda.append(god)
        pos.append(i)

plt.plot(close)
plt.xticks(pos, goda)

plt.plot(close, label='Цена закрытия')
plt.plot(x, p(x), color='red', label='Полином')
plt.xticks(pos, goda)
plt.legend()

plt.xlabel('Год')
plt.ylabel('Цена закрытия')
plt.title('Цена биткоина')
plt.grid()
plt.show()

